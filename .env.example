# Secrets: copy to .env on the Mac mini. Never commit the real file.
TUSHARE_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TO_USER=@all

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_API_TOKEN=

# Runtime
STOCKTOPIC_DB_PATH=./data/stocktopic.sqlite3
STOCKTOPIC_ARCHIVE_DIR=./data/archive
STOCKTOPIC_HOST=127.0.0.1
STOCKTOPIC_PORT=8765
PUBLIC_BASE_URL=https://stock.bnken.com
MINIMUM_LIMIT_TOUCHES=4
NOVELTY_LOOKBACK_TRADE_DAYS=60
NOVELTY_CONFIDENCE_THRESHOLD=70
CATALYST_CONFIDENCE_THRESHOLD=65
MINIMUM_EXPECTED_DURATION_DAYS=3
LEADER_UPSIDE_THRESHOLD_PCT=30
MAXIMUM_CANDIDATES_PER_RUN=4
CATALYST_REFRESH_HOURS=08:40,10:30,13:30,15:30
LOG_LEVEL=INFO
