# Secrets: copy to .env on the Mac mini. Never commit the real file.
TUSHARE_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TO_USER=@all

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
APP_API_TOKEN=

# Runtime
STOCKTOPIC_DB_PATH=./data/stocktopic.sqlite3
STOCKTOPIC_ARCHIVE_DIR=./data/archive
STOCKTOPIC_HOST=127.0.0.1
STOCKTOPIC_PORT=8765
ANOMALY_DISPLAY_MIN_SEVERITY=68
ANOMALY_DISCOVERY_MIN_SEVERITY=65
MAXIMUM_CANDIDATES_PER_RUN=8
CATALYST_REFRESH_HOURS=08:40,10:30,13:30,15:30
LOG_LEVEL=INFO
